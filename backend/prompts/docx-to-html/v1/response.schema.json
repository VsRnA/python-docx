{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astra full document response",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "response_type", "document", "warnings"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "response_type": { "const": "full_document" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "revision", "theme_id", "theme_version", "language", "html", "assets"],
      "properties": {
        "document_id": { "type": "string" },
        "revision": { "const": 1 },
        "theme_id": { "type": "string" },
        "theme_version": { "type": "string" },
        "language": { "type": "string" },
        "html": { "type": "string", "minLength": 1 },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset_id", "filename", "mime_type", "encoding", "data"],
            "properties": {
              "asset_id": { "type": "string" },
              "filename": { "type": "string" },
              "mime_type": { "enum": ["image/png", "image/jpeg", "image/webp", "image/svg+xml"] },
              "encoding": { "const": "base64" },
              "data": { "type": "string", "minLength": 1 },
              "width": { "type": ["integer", "null"], "minimum": 1 },
              "height": { "type": ["integer", "null"], "minimum": 1 },
              "alt": { "type": "string" }
            }
          }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
