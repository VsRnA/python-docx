APP_ENV=development
APP_NAME=Document Management Service
API_PREFIX=/api/v1
MAX_DOCX_SIZE_BYTES=52428800
DATABASE_URL=postgresql+asyncpg://document_service:document_service@localhost:5432/document_service
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_BUCKET=
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
OPENAI_API_KEY=
ASTRA_MODEL=gpt-6-astra
ASTRA_REASONING_EFFORT=xhigh
ASTRA_EDIT_REASONING_EFFORT=xhigh
ASTRA_REPAIR_REASONING_EFFORT=high
# Leave unset to allow long-running Astra requests to finish.
YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=
DOCUMENT_THEME_ID=villartec-manual-a5
DOCUMENT_THEME_VERSION=1.0
MAX_AI_FILE_INPUT_BYTES=52428800
ADAPTIVE_REPAIR_MAX_ITERATIONS=3
PUBLICATION_BASE_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-me
BASIC_AUTH_USER_ID=00000000-0000-0000-0000-000000000001
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
